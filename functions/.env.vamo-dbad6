# Env vars no-secretas aplicadas a TODAS las Cloud Functions del proyecto vamo-dbad6.
# Firebase CLI las pickea automáticamente al deployar con `--project=vamo-dbad6`.
# Secretos (API keys, tokens) van por defineSecret + Secret Manager, NO acá.

# Memorystore Redis L2 cache (IP privada, requiere VPC connector
# vamo-connector-saeast en la function). Si REDIS_HOST no está seteado,
# lib/redis-cache.js entra en modo bypass (L1 only). CRÍTICO: tener acá
# preserva las vars en re-deploys (gcloud run update queda pisado por
# Firebase deploy si no está en .env).
REDIS_HOST=10.10.147.107
REDIS_PORT=6379

# Telemetry hub Fase A (transport-side) — Pub/Sub topics que feedean tablas BQ
# vía subscriptions con --use-table-schema. Ver lib/telemetry.js + lib/eta-telemetry.js.
ETA_TELEMETRY_TOPIC=eta-telemetry
POSITIONS_TELEMETRY_TOPIC=bus-positions-telemetry
ARRIVALS_TELEMETRY_TOPIC=bus-arrivals-telemetry
